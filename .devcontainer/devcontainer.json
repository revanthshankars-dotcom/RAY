{
  "name": "RAY",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && pip install pytest",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "RAY interface",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "RAY_HOME": "${containerWorkspaceFolder}/.runtime"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
